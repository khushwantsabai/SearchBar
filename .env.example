# Shopify App Credentials
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"
SCOPES="write_products,write_metaobjects,write_metaobject_definitions"
SHOPIFY_APP_URL="https://your-app-tunnel.trycloudflare.com"

# Database Configuration (PostgreSQL in production, SQLite for local testing)
# SQLite: file:dev.sqlite
# PostgreSQL: postgresql://postgres:password@localhost:5432/searchbar_db?schema=public
DATABASE_URL="file:dev.sqlite"

# Billing Configuration (Optional overrides)
SHOPIFY_PRO_PLAN_PRICE="4.99"
SHOPIFY_ADVANCED_PLAN_PRICE="9.99"

# Support & Contact (Optional)
SUPPORT_CONTACT_URL="https://example.com/support"
SUPPORT_CONTACT_EMAIL="support@example.com"

# Server Port
PORT=3000

